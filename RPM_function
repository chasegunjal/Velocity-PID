#include "globals"
#include "headers"


void get_rpm()
{
    if (pulsePeriod == 0)
        return;
    actualrpm = 60.0e6 / (pulsePeriod * ppr);
    Serial.println(actualrpm);
    rpm_filter();
    pid();
}

void rpm_filter()
{
    float alpha = 0.2; // 0.1–0.3 works well
    rpmFiltered = alpha * actualRPM + (1 - alpha) * rpmFiltered;
}
