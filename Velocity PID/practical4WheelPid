#include <Arduino.h>

#define NUM_MOTORS 4
#define SAMPLE_TIME 100   // ms RPM measurement window

int motorPWM[NUM_MOTORS] = {2,4,6,8};
int motorDIR[NUM_MOTORS] = {3,5,7,9};

int encoderA[NUM_MOTORS] = {18,19,20,21};
int encoderB[NUM_MOTORS] = {22,23,24,25};

volatile long pulseCount[NUM_MOTORS] = {0};

const int PPR = 850;

float desiredRPM[NUM_MOTORS] = {80,80,80,80};
float targetRPM[NUM_MOTORS]  = {0};

float actualRPM[NUM_MOTORS] = {0};
float rpmFiltered[NUM_MOTORS] = {0};

float Kp = 0.6;
float Ki = 0.2;
float Kd = 0.02;

float integral[NUM_MOTORS] = {0};
float prevError[NUM_MOTORS] = {0};

int pwmOutput[NUM_MOTORS] = {0};
int pwmBias[NUM_MOTORS] = {40,40,40,40};

const float MAX_RPM = 200;

unsigned long prevTime = 0;

float rampRate = 0.15;


// -------- ENCODER ISR --------

void IRAM_ATTR encoderISR0(){ pulseCount[0]++; }
void IRAM_ATTR encoderISR1(){ pulseCount[1]++; }
void IRAM_ATTR encoderISR2(){ pulseCount[2]++; }
void IRAM_ATTR encoderISR3(){ pulseCount[3]++; }


// -------- RPM CALCULATION --------

void computeRPM()
{
    static unsigned long lastSample = 0;

    if(millis() - lastSample < SAMPLE_TIME)
        return;

    float dt = (millis()-lastSample)/1000.0;

    lastSample = millis();

    for(int i=0;i<NUM_MOTORS;i++)
    {
        long count = pulseCount[i];
        pulseCount[i] = 0;

        float rev = (float)count / PPR;

        actualRPM[i] = (rev/dt)*60.0;

        float alpha = 0.2;

        rpmFiltered[i] =
            alpha*actualRPM[i] +
            (1-alpha)*rpmFiltered[i];
    }
}


// -------- VELOCITY RAMP --------

void rampRPM()
{
    for(int i=0;i<NUM_MOTORS;i++)
    {
        desiredRPM[i] = constrain(desiredRPM[i],-MAX_RPM,MAX_RPM);

        targetRPM[i] += rampRate*(desiredRPM[i]-targetRPM[i]);
    }
}


// -------- PID CONTROL --------

void PIDControl(int i,float dt)
{
    float error = targetRPM[i] - rpmFiltered[i];

    integral[i] += error*dt;

    integral[i] = constrain(integral[i],-500,500);

    float derivative =
        (error - prevError[i]) / dt;

    float output =
        Kp*error +
        Ki*integral[i] +
        Kd*derivative;

    prevError[i] = error;

    pwmOutput[i] =
        pwmBias[i] + output;

    pwmOutput[i] =
        constrain(pwmOutput[i],0,255);

    analogWrite(motorPWM[i],pwmOutput[i]);
}


// -------- WHEEL SYNC --------

void synchronizeWheels()
{
    float avg = 0;

    for(int i=0;i<NUM_MOTORS;i++)
        avg += rpmFiltered[i];

    avg /= NUM_MOTORS;

    for(int i=0;i<NUM_MOTORS;i++)
    {
        float syncError = avg - rpmFiltered[i];

        pwmOutput[i] += syncError*0.1;
    }
}


// -------- SETUP --------

void setup()
{
    Serial.begin(115200);

    for(int i=0;i<NUM_MOTORS;i++)
    {
        pinMode(motorPWM[i],OUTPUT);
        pinMode(motorDIR[i],OUTPUT);

        pinMode(encoderA[i],INPUT_PULLUP);
        pinMode(encoderB[i],INPUT_PULLUP);
    }

    attachInterrupt(digitalPinToInterrupt(encoderA[0]),encoderISR0,RISING);
    attachInterrupt(digitalPinToInterrupt(encoderA[1]),encoderISR1,RISING);
    attachInterrupt(digitalPinToInterrupt(encoderA[2]),encoderISR2,RISING);
    attachInterrupt(digitalPinToInterrupt(encoderA[3]),encoderISR3,RISING);

    prevTime = millis();
}


// -------- MAIN LOOP --------

void loop()
{
    unsigned long now = millis();
    float dt = (now-prevTime)/1000.0;
    prevTime = now;

    computeRPM();

    rampRPM();

    for(int i=0;i<NUM_MOTORS;i++)
        PIDControl(i,dt);

    synchronizeWheels();

    Serial.print("RPM: ");

    for(int i=0;i<NUM_MOTORS;i++)
    {
        Serial.print(rpmFiltered[i]);
        Serial.print(" ");
    }

    Serial.print("| PWM: ");

    for(int i=0;i<NUM_MOTORS;i++)
    {
        Serial.print(pwmOutput[i]);
        Serial.print(" ");
    }

    Serial.println();
}
